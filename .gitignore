# Ignore legacy pickle model files
*.pkl
.venv
.venv/
# Local uv.toml overrides (e.g. editable path source for active sibling-repo
# co-development) — machine-specific, never commit.
/uv.toml
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.log

*.pkl
*.eqx
.DS_Store
.coverage
*.pt
*.csv

# Local proxide development folder (installed via git dependency)
proxide/

# Local reference LigandMPNN checkout (default scripts path)
reference_ligandmpnn_clone/

# Training checkpoints
checkpoints/
checkpoints_test/

data/pdb_cache/.worktrees/
.agent/
.agent/skills
data/pdb_cache/*
.worktrees/

# Campaign worker/runtime artifacts
*.h5.lock
*.h5.partial.*
*.h5.done.json
tests/run/_grid_artifacts/

# Local verification / agent slice logs (use `.agents/verification_logs/` for committed evidence)
logs/

# Local pytest-json-report / coverage blobs (keep scripts under .praxia/)
.praxia/pytest_errors/
.praxia/*_console*.log
.praxia/fast_pytest*.log
# `praxia dispatch` writes its own envelope.json here, INSIDE the worktree it is
# about to materialize into, and then refuses the dispatch because that same file
# makes the tree unclean. Untracked-and-ignored is the only state that satisfies
# its precondition, so this entry is what lets a surface dispatch run at all.
.praxia/dispatch/
venv/
scratch/

# fastembed / embedding model cache (ONNX blobs, never commit)
.fastembed_cache/
docs/_build/
scripts/scratch/

# bathos per-run provenance lock files (a fresh one is written every `bth run`)
*.bth.lock.toml

# Claude Code worktrees: ephemeral, agent-local checkouts of this same repo.
# Never track these -- doing so nests a full copy of the tree under
# .claude/worktrees/<name>/ (1462 files from 3 stale worktrees were found
# accidentally committed 2026-05-14 onward before this rule existed).
.claude/worktrees/

# Browser validation (Phase 0 T3+): npm deps and the local Playwright
# Chromium download (PLAYWRIGHT_BROWSERS_PATH is pinned inside browser/**
# because the shared ~/.cache/ms-playwright is not writable under this
# project's sandbox policy) -- never commit either.
browser/**/node_modules/
browser/**/.cache/

# Playwright Test runner scratch (browser/layer_c/tests/threads.spec.mjs, T5a): the
# default test-results/ report dir and a leftover playwright-report/ HTML report, plus
# the ephemeral static-site fixture threads.spec.mjs builds and removes in afterAll
# (defensive -- it is not supposed to survive a run, but never commit it if it does).
browser/**/test-results/
browser/**/playwright-report/
browser/layer_c/.test-site/

# Claude Code background-job scratch space (per-job tmp dirs; should never
# land under the repo, but a relative path can resolve here by mistake).
.claude/jobs/

# Gate output. Bathos also creates outputs/<id8>/ after it has captured git
# state (runner.py), so a tracked tree would look dirty the moment a run starts.
/outputs/

# xtrax scratch/cache written beside the checkout during a run. Left untracked
# it dirties the tree, and the section 1c ledger REJECTS a run whose record says
# git_dirty -- so an ignorable cache can silently cost a gate-eligible result.
.xtrax/

# Browser-validation (Phase 1 T4): read-only reference clones fetched fresh by
# pins.py, and per-run outputs (parity results, titanix rsync mirrors, run
# ledgers). Files that must stay tracked under outputs/browser_validation/
# (params, the run ledger, fixture manifest/raw fixtures) are `git add -f`'d
# individually per the T4 common context -- this ignore is deliberately not
# narrowed to a subpath so `git status --porcelain` (git_clean, R2-C13) does
# not see them as untracked noise.
.cache/
outputs/browser_validation/
node_modules/
.bth/synthetic_recovery_ledger.json
*.bth.lock.toml

# bathos writes .bth/refs/manifest.jsonl into the run tree during `bth run`; it made the
# titanix provenance smoke see git_dirty=true (T4 attempt 1).
.bth/refs/
