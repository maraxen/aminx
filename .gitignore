# Ignore legacy pickle model files
*.pkl
.venv
.venv/
# Local uv.toml overrides (e.g. editable path source for active sibling-repo
# co-development) — machine-specific, never commit.
/uv.toml
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.log

*.pkl
*.eqx
.DS_Store
.coverage
*.pt
*.csv

# Local proxide development folder (installed via git dependency)
proxide/

# Local reference LigandMPNN checkout (default scripts path)
reference_ligandmpnn_clone/

# Training checkpoints
checkpoints/
checkpoints_test/

data/pdb_cache/.worktrees/
.agent/
.agent/skills
data/pdb_cache/*
.worktrees/

# Campaign worker/runtime artifacts
*.h5.lock
*.h5.partial.*
*.h5.done.json
tests/run/_grid_artifacts/

# Local verification / agent slice logs (use `.agents/verification_logs/` for committed evidence)
logs/

# Local pytest-json-report / coverage blobs (keep scripts under .praxia/)
.praxia/pytest_errors/
.praxia/*_console*.log
.praxia/fast_pytest*.log
# `praxia dispatch` writes its own envelope.json here, INSIDE the worktree it is
# about to materialize into, and then refuses the dispatch because that same file
# makes the tree unclean. Untracked-and-ignored is the only state that satisfies
# its precondition, so this entry is what lets a surface dispatch run at all.
.praxia/dispatch/
venv/
scratch/

# fastembed / embedding model cache (ONNX blobs, never commit)
.fastembed_cache/
docs/_build/
scripts/scratch/

# bathos per-run provenance lock files (a fresh one is written every `bth run`)
*.bth.lock.toml

# Claude Code worktrees: ephemeral, agent-local checkouts of this same repo.
# Never track these -- doing so nests a full copy of the tree under
# .claude/worktrees/<name>/ (1462 files from 3 stale worktrees were found
# accidentally committed 2026-05-14 onward before this rule existed).
.claude/worktrees/

# Claude Code background-job scratch space (per-job tmp dirs; should never
# land under the repo, but a relative path can resolve here by mistake).
.claude/jobs/
