{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aminx.local/schemas/branch_manifest.schema.json",
  "title": "Branch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["branch"],
  "properties": {
    "branch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "vehicle", "fixture", "mutant"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "minLength": 1},
          "fixture": {"type": "string"},
          "mutant": {"type": "string", "minLength": 1},
          "vehicle": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "nodeids"],
                "properties": {
                  "kind": {"const": "pytest"},
                  "nodeids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "slug"],
                "properties": {
                  "kind": {"const": "sidecar"},
                  "slug": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        }
      }
    }
  }
}
